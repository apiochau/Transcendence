# database postgres
POSTGRES_USER=lexmon
POSTGRES_PASSWORD=lexmon
POSTGRES_DB=lexmon

# jwt
JWT_SECRET=change-me-in-production

# OAuth
# Copy this file to .env, then replace the six empty values below.
# The secrets are injected into Vault by docker compose; never expose them to Vite.
# Google redirect URI: https://localhost:8443/api/auth/oauth/google/callback
# GitHub callback URL: https://localhost:8443/api/auth/oauth/github/callback
# 42 redirect URI: https://localhost:8443/api/auth/oauth/42/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_42_CLIENT_ID=
OAUTH_42_CLIENT_SECRET=
