generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum GameStatus {
  WAITING
  ACTIVE
  FINISHED
  CANCELLED
}

enum TournamentStatus {
  DRAFT
  OPEN
  ACTIVE
  FINISHED
}

enum SentimentType {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  username          String            @unique
  passwordHash      String
  displayName       String?
  avatarUrl         String?
  oauthProvider     String?
  oauthId           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sentFriends       Friendship[]      @relation("FriendRequester")
  receivedFriends   Friendship[]      @relation("FriendAddressee")
  gamesAsPlayerOne  Game[]            @relation("PlayerOneGames")
  gamesAsPlayerTwo  Game[]            @relation("PlayerTwoGames")
  wins              Game[]            @relation("WinnerGames")
  stats             UserStats?
  notifications     Notification[]
  tournamentEntries TournamentEntry[]
  wordCollection    WordCollectionItem[]
  dailyMatchAttempts DailyMatchAttempt[]
  wordStakeLocks     WordStakeLock[]
  sentMessages      Message[]         @relation("MessageSender")
  receivedMessages  Message[]         @relation("MessageRecipient")

  feedbacks         Feedback[]
  twoFactorEnabled  Boolean           @default(false)
  twoFactorSecret   String?
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model Game {
  id          String     @id @default(uuid())
  roomId      String     @unique
  status      GameStatus @default(WAITING)
  playerOneId String
  playerTwoId String?
  winnerId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  playerOne   User       @relation("PlayerOneGames", fields: [playerOneId], references: [id])
  playerTwo   User?      @relation("PlayerTwoGames", fields: [playerTwoId], references: [id])
  winner      User?      @relation("WinnerGames", fields: [winnerId], references: [id])
}

model UserStats {
  id          String   @id @default(uuid())
  userId      String   @unique
  gamesPlayed Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)
  rating      Int      @default(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id              String                @id @default(uuid())
  content         String
  senderId        String
  sender          User                  @relation("MessageSender", fields:[senderId], references: [id], onDelete: Cascade)
  recipientId     String?
  recipient       User?                 @relation("MessageRecipient", fields:[recipientId], references: [id], onDelete: Cascade)
  isGlobal        Boolean               @default(false)
  createdAt       DateTime              @default(now())
}

model Tournament {
  id        String            @id @default(uuid())
  name      String
  status    TournamentStatus  @default(DRAFT)
  startsAt  DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  entries   TournamentEntry[]
}

model TournamentEntry {
  id           String     @id @default(uuid())
  tournamentId String
  userId       String
  seed         Int?
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Word {
  id                String              @id
  text              String
  normalizedText    String              @unique
  rarity            Int                 @default(50)
  value             Int                 @default(1)
  rarityLabel       String              @default("common")
  category          String?
  embedding         Json
  secretSessions    GameSession[]       @relation("SecretWordSessions")
  suggestionHistory SuggestionHistory[]
  collectionItems   WordCollectionItem[]
  stakeLocks        WordStakeLock[]
}

model WordCollectionItem {
  id          String   @id @default(uuid())
  userId      String
  wordId      String
  quantity    Int      @default(1)
  firstWonAt  DateTime @default(now())
  lastWonAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word        Word     @relation(fields: [wordId], references: [id])

  @@unique([userId, wordId])
  @@index([userId])
}

model DailyMatchAttempt {
  id        String   @id @default(uuid())
  userId    String
  dayKey    String
  roomId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@index([dayKey])
}

model WordStakeLock {
  id        String    @id @default(uuid())
  userId    String
  wordId    String
  rarity    String
  roomId    String?
  status    String    @default("QUEUED")
  createdAt DateTime  @default(now())
  settledAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      Word      @relation(fields: [wordId], references: [id])

  @@index([userId, status])
  @@index([rarity, status])
  @@index([roomId])
}

model GameSession {
  id               String              @id @default(uuid())
  secretWordId     String
  playerId         String
  status           String              @default("ACTIVE")
  shownWordIds     String[]            @default([])
  currentWordIds   String[]            @default([])
  nextSuggestionsAt DateTime?
  createdAt        DateTime            @default(now())
  finishedAt       DateTime?
  secretWord       Word                @relation("SecretWordSessions", fields: [secretWordId], references: [id])
  suggestionHistory SuggestionHistory[]
  feedbacks        Feedback[]
}

model SuggestionHistory {
  id        String      @id @default(uuid())
  sessionId String
  playerId  String
  wordId    String
  score     Int
  bucket    String
  createdAt DateTime    @default(now())
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word      Word        @relation(fields: [wordId], references: [id])

  @@unique([sessionId, wordId])
  @@index([sessionId, createdAt])
}

model Feedback {
  id         String   @id @default(uuid())

  userId     String
  sessionId  String

  content    String

  sentiment  SentimentType?
  score      Float?

  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])

  @@index([userId])
  @@index([sessionId])
}
